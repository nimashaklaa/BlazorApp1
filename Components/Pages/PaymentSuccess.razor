@page "/payment-success"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>Payment Successful</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card">
                <div class="card-body">
                    <div class="mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-check-circle-fill text-success" viewBox="0 0 16 16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                        </svg>
                    </div>
                    <h1 class="text-success mb-3">Payment Successful!</h1>
                    <p class="lead">Thank you for your payment.</p>

                    @if (sessionDetails != null)
                    {
                        <div class="mt-4 text-start">
                            <h5>Payment Details</h5>
                            <p><strong>Status:</strong> @sessionDetails.Status</p>
                            @if (!string.IsNullOrEmpty(sessionDetails.CustomerEmail))
                            {
                                <p><strong>Email:</strong> @sessionDetails.CustomerEmail</p>
                            }
                            @if (sessionDetails.AmountTotal.HasValue)
                            {
                                <p><strong>Amount:</strong> $@((sessionDetails.AmountTotal.Value / 100m).ToString("F2"))</p>
                            }
                        </div>
                    }

                    <div class="mt-4">
                        <a href="/" class="btn btn-primary">Return to Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "session_id")]
    public string? SessionId { get; set; }

    private SessionDetails? sessionDetails;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(SessionId))
        {
            try
            {
                var httpClient = new HttpClient { BaseAddress = new Uri(Navigation.BaseUri) };
                sessionDetails = await httpClient.GetFromJsonAsync<SessionDetails>($"api/payment/session/{SessionId}");
            }
            catch
            {
                // Handle error silently - we still want to show success message
            }
        }
    }

    public class SessionDetails
    {
        public string Status { get; set; } = string.Empty;
        public string? CustomerEmail { get; set; }
        public long? AmountTotal { get; set; }
    }
}
